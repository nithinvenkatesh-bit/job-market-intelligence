# Python
__pycache__/
*.py[cod]
.venv/

# Secrets - never commit
.env

# Data - large and regenerable
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.duckdb
*.parquet
*.csv

# Version-controlled dbt lookup seeds
!dbt/seeds/*.csv

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/

# OS / editor
.DS_Store
.vscode/

# Testing
.pytest_cache/
.coverage

# Airflow
airflow_home/
# Local timestamped source backups
*_before_*.py

# Version-controlled aggregated Looker Studio exports
!looker_studio/data/*.csv

# Generated local annotation interface
/docs/annotate.html
